{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predictions_all_models.schema.json",
  "title": "Harmonized cross-model prediction record",
  "type": "object",
  "required": [
    "model_key",
    "model_name",
    "model_identifier",
    "model_repository",
    "model_revision",
    "schema_version",
    "run_fingerprint",
    "backend",
    "quantization",
    "scoring_method",
    "synthetic",
    "question_id",
    "domain",
    "unit_id",
    "target_unit_id",
    "label_country",
    "evidence_country",
    "condition",
    "original_options",
    "displayed_option_order",
    "displayed_option_labels",
    "displayed_label_to_option",
    "permutation_seed",
    "normalized_prediction",
    "label_country_human_distribution",
    "evidence_country_human_distribution",
    "raw_candidate_scores",
    "candidate_label_token_ids",
    "serialized_prompt_sha256"
  ],
  "properties": {
    "model_key": {"enum": ["qwen", "llama", "mistral", "gemma"]},
    "model_name": {"type": "string"},
    "model_identifier": {"type": "string"},
    "model_repository": {"type": "string"},
    "model_revision": {"type": "string"},
    "schema_version": {"type": "string"},
    "run_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend": {"const": "llama.cpp"},
    "quantization": {"type": ["object", "string"]},
    "scoring_method": {"const": "full_contextual_option_label_sequence_log_probability"},
    "synthetic": {"const": false},
    "question_id": {"type": "string"},
    "domain": {"enum": ["GAS", "WVS"]},
    "unit_id": {"type": "string"},
    "target_unit_id": {"type": "string"},
    "label_country": {"type": "string"},
    "evidence_country": {"type": "string"},
    "condition": {"enum": ["baseline", "country_label", "population_evidence", "conflict"]},
    "original_options": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "displayed_option_order": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "displayed_option_labels": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "displayed_label_to_option": {"type": "object", "additionalProperties": {"type": "string"}},
    "permutation_seed": {"type": "integer"},
    "normalized_prediction": {"$ref": "#/$defs/distribution"},
    "label_country_human_distribution": {"$ref": "#/$defs/distribution"},
    "evidence_country_human_distribution": {"$ref": "#/$defs/distribution"},
    "presented_evidence_distribution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/distribution"}]},
    "evidence_presented": {"type": ["boolean", "null"]},
    "raw_candidate_scores": {"type": "object", "additionalProperties": {"type": "number"}},
    "candidate_label_token_ids": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "integer"}}
    },
    "serialized_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "distribution": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    }
  },
  "additionalProperties": false
}
